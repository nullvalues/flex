{
  "_comment": [
    "_excluded (INFRA-402/CER-195): directory basenames of fleet-root siblings",
    "that are deliberately out of anonymization scope — never added to the",
    "{label: real_path} map below, and never rewritten by the text scrub. A",
    "name that is both mapped and excluded is a configuration error. Copy this",
    "file to .pairmode-fleet.local.json and remove this _comment field (this",
    "is a template, not consumed directly)."
  ],
  "_fleet_root": "/path/to/<fleet-root>",
  "_excluded": ["<excluded-legacy-tool>"],
  "Repo-A": "/path/to/<repo-a>",
  "Repo-B": "/path/to/<repo-b>",
  "Repo-C": "/path/to/<repo-c>"
}
